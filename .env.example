# Copy to .env.local and fill in. NEVER commit .env.local.

# PostgreSQL connection string (local: postgres://user:password@localhost:5432/novaworks)
DATABASE_URL=
# Random string, 32+ chars, used to sign session cookies
SESSION_SECRET=

# Providers are tried in this order (comma separated). Missing keys are skipped.
LLM_PROVIDER_ORDER=gemini,groq,openrouter

# Google AI Studio (Gemini) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash

# Groq -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile

# OpenRouter -> https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
